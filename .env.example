# ==============================================================================
# CYNBIT TECHNOLOGIES — REFERENCE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your local or production credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="Cynbit Technologies — Secure Inquiry API"
API_V1_PREFIX=/api/v1
DEBUG=false

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Security & Cryptographic Tokens
# Generate a secure 256-bit secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (Comma-separated list of trusted client origins)
CORS_ORIGINS=http://localhost:3000,https://cynbit.in,https://www.cynbit.in,https://portal.cynbit.in

# Database Configuration
# Default production MySQL connection string:
DATABASE_URL=mysql+pymysql://cynbit_user:cynbit_secure_password@localhost:3306/cynbit_inquiries_db

# Alternative local SQLite fallback for testing or lightweight development:
# DATABASE_URL=sqlite:///./cynbit_inquiries.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Initial Super Admin Seed Credentials (Optional: Used for initial database bootstrap)
INITIAL_SUPERADMIN_EMAIL=admin@cynbit.in
INITIAL_SUPERADMIN_PASSWORD=ChangeMeAdmin2026!
INITIAL_SUPERADMIN_NAME=Cynbit Lead Architect

